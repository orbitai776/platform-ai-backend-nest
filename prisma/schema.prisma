generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model admin_sessions {
  id                 String    @id @db.Uuid
  admin_id           String    @db.Uuid
  ip_address         String?   @db.VarChar(45)
  user_agent         String?
  refresh_token_hash String    @db.VarChar(255)
  expires_at         DateTime  @db.Timestamp(6)
  is_revoked         Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  admins             admins    @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([admin_id], map: "idx_admin_sessions_admin_id")
  @@index([expires_at], map: "idx_admin_sessions_expiry")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model admins {
  id             String           @id @db.Uuid
  email          String           @unique @db.VarChar(255)
  password_hash  String           @db.VarChar(255)
  full_name      String?          @db.VarChar(255)
  role           String?          @default("admin") @db.VarChar(50)
  is_active      Boolean?         @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  admin_sessions admin_sessions[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model embedding_config {
  id                 String           @id @db.Uuid
  partner_service_id String           @unique @db.Uuid
  partner_id         String           @db.Uuid
  embed_code         String?
  allowed_origins    Json?
  settings           Json?
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  updated_at         DateTime?        @default(now()) @db.Timestamp(6)
  partners           partners         @relation(fields: [partner_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partner_services   partner_services @relation(fields: [partner_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([partner_id], map: "idx_embed_config_partner")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model guest_sessions {
  id                 String           @id @db.Uuid
  partner_service_id String           @db.Uuid
  anonymous_id       String           @unique @db.VarChar(255)
  device_fingerprint String?          @db.VarChar(255)
  ip_address         String?          @db.VarChar(45)
  user_agent         String?
  status             String?          @default("active") @db.VarChar(20)
  converted_user_id  String?          @db.Uuid
  expires_at         DateTime         @db.Timestamp(6)
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  users              users?           @relation(fields: [converted_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  partner_services   partner_services @relation(fields: [partner_service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([expires_at], map: "idx_guest_sessions_expiry")
  @@index([partner_service_id], map: "idx_guest_sessions_ps_id")
  @@index([status], map: "idx_guest_sessions_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model order_details {
  id               String    @id @db.Uuid
  order_id         String    @db.Uuid
  product_id       String    @db.Uuid
  quantity         Int       @default(1)
  unit_price       Decimal   @db.Decimal(12, 2)
  product_snapshot Json?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  orders           orders    @relation(fields: [order_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products         products  @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_details_order_id")
